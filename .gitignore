# Secrets — NEVER commit. Hermes keeps these in ~/.hermes/.env, not here.
.env
.env.*
!.env.example
*.local
secrets/
*.pem
*.key
.venv
# Run worktrees. Hermes and `cuzam launch` both cut them here, and a
# stray `git add -A` in the primary checkout would commit one as a gitlink.
.worktrees/
__pycache__/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.cuzam/

# Local planning and agent-run artifacts
HANDOVER.md
.superpowers/
STATE.md
docs/linear-backfill-draft.md
docs/superpowers/
docs/01-plan.md
docs/02-phase1-setup.md
docs/04-hermes-config-in-repo.md
docs/05-durable-work-runbook.md
docs/features/*.CHANGELOG.md

# The secrets override slot, when it lands here. `user_env_path()` derives it
# from `user_config_path()`, so `CUZAM_CONFIG=$repo/cuzam.yaml` — which
# scripts/check.sh sets on every run — puts it at `<repo>/env`. Nothing in
# scan-secrets.sh matches a Linear key, so without this line a credential
# dropped there would pass both gates.
/env

# Slack/Linear tokens if ever dropped locally
*xoxb-*
*xapp-*

# Hermes cron runtime state (locks/heartbeats — not config)
hermes/cron/.*.lock
hermes/cron/*.lock
hermes/cron/ticker_*
hermes/cron/jobs.json

# OS / editor
.DS_Store
.obsidian/
*.swp

# Hermes cron run output (runtime, not config)
hermes/cron/output/
