{
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(curl * | sh *)",
      "Bash(curl * | bash *)",
      "Bash(wget * | sh *)",
      "Bash(gcloud * delete *)",
      "Bash(gcloud projects delete *)",
      "Bash(gcloud billing *)",
      "Bash(gcloud iam service-accounts keys create *)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.config/gcloud/*)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.hermes/.env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*id_rsa*)",
      "Read(**/*id_ed25519*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(rmdir *)",
      "Bash(git clean *)",
      "Bash(trash *)"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gcloud * describe *)",
      "Bash(gcloud * list *)",
      "Bash(gcloud projects get-iam-policy *)"
    ]
  }
}
