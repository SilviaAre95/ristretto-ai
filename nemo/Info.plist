<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Nemo</string>
  <key>CFBundleDisplayName</key><string>Nemo</string>
  <key>CFBundleIdentifier</key><string>com.ristretto.nemo</string>
  <key>CFBundleExecutable</key><string>Nemo</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <!-- Without a bundle identifier and this string, macOS refuses the
       microphone outright: TCC has nothing to attribute the request to and
       no sentence to show you. A bare binary cannot ask. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Nemo listens only while you hold the mouse on it, so you can talk to Ris.</string>
  <!-- Agent, not application: no Dock icon, no menu bar, never in the
       app switcher. Nemo is furniture. -->
  <key>LSUIElement</key><true/>
  <!-- App Transport Security blocks plain HTTP from an app, so the first
       thing Nemo ever said was "the App Transport Security policy requires
       the use of a secure connection" — the request never left the machine.
       The dashboard is HTTP on a tailnet address.

       Narrow rather than blanket: NSAllowsArbitraryLoads would switch ATS off
       for everything Nemo ever loads. These two exceptions cover exactly
       where the dashboard can live — a tailnet name (*.ts.net) or this
       machine's own network — and nothing else.

       The real fix is HTTPS on the tailnet (tailscale cert/serve), which also
       unlocks microphone access from a phone. Until that is enabled, this. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key><true/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>ts.net</key>
      <dict>
        <key>NSIncludesSubdomains</key><true/>
        <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
