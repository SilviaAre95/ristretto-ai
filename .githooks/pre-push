#!/usr/bin/env bash
# Refuse to push any ref descended from Cuzam's private-history root.
set -euo pipefail

# RISTRETTO_PRIVATE_ROOT_COMMIT is the pre-rename spelling. Drop it in 0.3.0 —
# and drop it here and in scripts/install.sh in the SAME change: this guard
# and the installer that validates the root commit must agree, and a sweep
# that removes one fallback leaves the other enforcing a different root.
private_root="${CUZAM_PRIVATE_ROOT_COMMIT:-${RISTRETTO_PRIVATE_ROOT_COMMIT:-4ebdb7a3919a48cba84bf39ccd424fcdd9221210}}"
zero=0000000000000000000000000000000000000000

# The sentinel is deliberately absent from a history-free public export.
if ! git cat-file -e "${private_root}^{commit}" 2>/dev/null; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" != "$zero" ] || continue
  if git merge-base --is-ancestor "$private_root" "$local_sha" 2>/dev/null; then
    cat >&2 <<'EOF'
PUSH BLOCKED: this ref contains Cuzam's private Git history.

Never attach a public remote to this repository. Create a fresh history with:
  scripts/export-public.sh /absolute/path/to/new-public-repo

Then configure a privacy-safe Git identity and push only from that export.
EOF
    exit 1
  fi
done

exit 0
